g.svg","alt_text":"Illustration of Apollo Pharmacy Vivekananda Marg (pharmacy) - demo image, not a photograph"},{"facility_slug":"thyrocare-bapuji-nagar","public_path":"/images/facilities/thyrocare-bapuji-nagar.svg","alt_text":"Illustration of Thyrocare Bapuji Nagar (diagnostic lab) - demo image, not a photograph"}]$json$::jsonb) as r(facility_slug text, public_path text, alt_text text)
  join public.facilities f on f.slug = r.facility_slug
  where not exists (select 1 from public.facility_images i where i.facility_id = f.id and i.public_path = r.public_path);
end
$seed$;
