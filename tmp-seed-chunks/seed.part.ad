  where exists (select 1 from public.facility_practitioners p where p.id = r.practitioner_id)
    and not exists (select 1 from public.practitioner_schedule s where s.practitioner_id = r.practitioner_id);

  insert into public.facility_images (facility_id, public_path, alt_text, source_url, rights_basis, position, published)
